{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "regex",
          "path": "backup-k8s-gpg.sh",
          "search": "VERSION=\\\"[^\\\"]+\\\"",
          "replace": "VERSION=\\\"${version}\\\""
        },
        {
          "type": "regex",
          "path": "Makefile",
          "search": "VERSION := .*",
          "replace": "VERSION := ${version}"
        }
      ]
    }
  }
}
